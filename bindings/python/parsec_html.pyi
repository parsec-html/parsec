"""Parsec, an HTML parser that follows the WHATWG spec, with CSS selectors
and an editable tree. The API follows selectolax's Lexbor backend."""

from collections.abc import Iterable, Iterator
from typing import Literal, Optional, TypeVar, Union, overload

__version__: str

_T = TypeVar("_T")

# What xpath() gives, as lxml gives it: a list for a node-set (elements and
# comments as nodes, text and attribute values as strings), or a scalar.
XPathResult = Union[list[Union["Node", str]], str, float, bool]
XPathVariable = Union[str, bytes, float, int, bool]

class SelectorError(ValueError):
    """A CSS selector that doesn't parse."""

class XPathError(ValueError):
    """An XPath expression that doesn't parse, or that can't be evaluated."""

class ParseError:
    """A parse error the parser recovered from. A record, not an exception."""

    @property
    def code(self) -> str: ...
    @property
    def offset(self) -> int: ...
    @property
    def line(self) -> int: ...
    @property
    def column(self) -> int: ...

class HTMLParser:
    """A parsed page, or a fragment, with selectolax's API plus xpath().
    Any number of threads may read and edit one parser at once."""
    def __init__(
        self,
        html: Union[str, bytes],
        is_fragment: bool = False,
        fragment_tag: str = "div",
        fragment_namespace: str = "html",
        scripting: bool = False,
        budget: Optional[float] = None,
        max_depth: Optional[int] = None,
        url: Optional[str] = None,
        positions: bool = False,
        errors: bool = False,
        transport_encoding: Optional[str] = None,
        default_encoding: Optional[str] = None,
    ) -> None:
        """A str is parsed as it is. bytes are decoded in the encoding a
        browser would pick: a byte order mark's, else transport_encoding,
        else a <meta>'s, else UTF-8 if they're valid UTF-8, else
        default_encoding (windows-1252)."""
    @property
    def encoding(self) -> Optional[str]:
        """The Encoding Standard's name for what bytes were decoded from,
        such as "UTF-8" or "Shift_JIS"; None for a str."""
    @property
    def encoding_confidence(self) -> Optional[Literal["certain", "tentative"]]: ...
    @property
    def errors(self) -> list[ParseError]: ...
    @property
    def root(self) -> Optional[Node]: ...
    @property
    def head(self) -> Optional[Node]: ...
    @property
    def body(self) -> Optional[Node]: ...
    @property
    def html(self) -> str: ...
    def text(
        self,
        deep: bool = True,
        separator: str = "",
        strip: bool = False,
        skip_empty: bool = False,
    ) -> str: ...
    def css(self, query: str) -> list[Node]: ...
    @overload
    def css_first(self, query: str, default: None = None, strict: bool = False) -> Optional[Node]: ...
    @overload
    def css_first(self, query: str, default: _T, strict: bool = False) -> Union[Node, _T]: ...
    def css_matches(self, selector: str) -> bool: ...
    def any_css_matches(self, selectors: Iterable[str]) -> bool: ...
    def tags(self, name: str) -> list[Node]: ...
    def xpath(self, query: str, **variables: XPathVariable) -> XPathResult: ...
    def line_col(self, offset: int) -> tuple[int, int]:
        """The line and column, from 1, of an index into the input, as
        source_range counts. With neither positions nor errors on, offset
        is a UTF-8 byte offset into the parsed text instead."""
    def create_node(self, tag: str) -> Node: ...
    def merge_text_nodes(self) -> None: ...
    def strip_tags(self, tags: Iterable[str], recursive: bool = False) -> None: ...
    def unwrap_tags(self, tags: Iterable[str], delete_empty: bool = False) -> None: ...

class Node:
    """A node of a parsed page. It stays valid as the page changes, and
    after it's taken out with remove()."""
    @property
    def tag(self) -> Optional[str]: ...
    @property
    def id(self) -> Optional[str]: ...
    @property
    def attributes(self) -> dict[str, str]: ...
    @property
    def attrs(self) -> Attributes: ...
    @property
    def html(self) -> str: ...
    @property
    def inner_html(self) -> str: ...
    @inner_html.setter
    def inner_html(self, html: Union[str, bytes]) -> None: ...
    def text(
        self,
        deep: bool = True,
        separator: str = "",
        strip: bool = False,
        skip_empty: bool = False,
    ) -> str: ...
    @property
    def text_content(self) -> Optional[str]: ...
    @property
    def comment_content(self) -> Optional[str]: ...
    @property
    def parent(self) -> Optional[Node]: ...
    @property
    def next(self) -> Optional[Node]: ...
    @property
    def prev(self) -> Optional[Node]: ...
    @property
    def first_child(self) -> Optional[Node]: ...
    @property
    def child(self) -> Optional[Node]: ...
    @property
    def last_child(self) -> Optional[Node]: ...
    @property
    def parser(self) -> HTMLParser: ...
    @property
    def is_element_node(self) -> bool: ...
    @property
    def is_text_node(self) -> bool: ...
    @property
    def is_comment_node(self) -> bool: ...
    @property
    def is_document_node(self) -> bool: ...
    @property
    def is_empty_text_node(self) -> bool: ...
    def iter(self, include_text: bool = False, skip_empty: bool = False) -> Iterator[Node]: ...
    def traverse(self, include_text: bool = False, skip_empty: bool = False) -> Iterator[Node]: ...
    def css(self, query: str) -> list[Node]: ...
    @overload
    def css_first(self, query: str, default: None = None, strict: bool = False) -> Optional[Node]: ...
    @overload
    def css_first(self, query: str, default: _T, strict: bool = False) -> Union[Node, _T]: ...
    def css_matches(self, selector: str) -> bool: ...
    def any_css_matches(self, selectors: Iterable[str]) -> bool: ...
    def xpath(self, query: str, **variables: XPathVariable) -> XPathResult: ...
    @property
    def source_range(self) -> Optional[tuple[int, int]]: ...
    @property
    def end_tag_range(self) -> Optional[tuple[int, int]]: ...
    @property
    def position(self) -> Optional[tuple[int, int]]: ...
    def attribute_range(self, name: str) -> Optional[tuple[int, int]]: ...
    def decompose(self, recursive: bool = True) -> None:
        """Takes the node out for good: this handle, and any for a node in
        it, reads as empty, keeping only its tag; xpath() and putting it
        back raise ValueError. ValueError for the document node; unlike
        selectolax, the <html> element (root) can be decomposed."""
    def remove(self, recursive: bool = True) -> None:
        """Takes the node out, still readable, to keep or put back with
        move=True."""
    def unwrap(self, delete_empty: bool = False) -> None: ...
    def unwrap_tags(self, tags: Iterable[str], delete_empty: bool = False) -> None:
        """Replaces every element matching one of tags with its contents,
        this node included if it matches."""
    def strip_tags(self, tags: Iterable[str], recursive: bool = False) -> None:
        """Decomposes every element matching one of tags, this node
        included if it matches."""
    def replace_with(self, value: Union[str, bytes, Node], move: bool = False) -> None: ...
    def insert_before(self, value: Union[str, bytes, Node], move: bool = False) -> None: ...
    def insert_after(self, value: Union[str, bytes, Node], move: bool = False) -> None: ...
    def insert_child(self, value: Union[str, bytes, Node], move: bool = False) -> None: ...
    def merge_text_nodes(self) -> None: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

class Attributes:
    def __getitem__(self, key: str) -> str: ...
    def __setitem__(self, key: str, value: Optional[str]) -> None: ...
    def __delitem__(self, key: str) -> None: ...
    def __contains__(self, key: str) -> bool: ...
    def __len__(self) -> int: ...
    def __iter__(self) -> Iterator[str]: ...
    def keys(self) -> list[str]: ...
    def values(self) -> list[str]: ...
    def items(self) -> list[tuple[str, str]]: ...
    @overload
    def get(self, key: str, default: None = None) -> Optional[str]: ...
    @overload
    def get(self, key: str, default: _T) -> Union[str, _T]: ...
    def sget(self, key: str, default: str = "") -> str: ...

class StreamParser:
    """Parses bytes a piece at a time: feed() each, then close() for the
    HTMLParser that the whole would give."""

    def __init__(
        self,
        scripting: bool = False,
        budget: Optional[float] = None,
        max_depth: Optional[int] = None,
        url: Optional[str] = None,
        positions: bool = False,
        errors: bool = False,
        transport_encoding: Optional[str] = None,
        default_encoding: Optional[str] = None,
    ) -> None: ...
    def feed(self, data: bytes) -> None: ...
    def close(self) -> HTMLParser: ...

def encoding_for_locale(locale: str) -> str:
    """The encoding a browser set to this language falls back to, for
    default_encoding: "ja" gives "Shift_JIS"."""
