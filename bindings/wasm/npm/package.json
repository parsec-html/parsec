{
  "name": "parsec-web",
  "version": "0.3.0",
  "description": "An HTML parser that follows the WHATWG spec, with CSS selectors and an editable tree: native in Node where there's a build for the machine, WebAssembly everywhere else.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parsec-html/parsec.git",
    "directory": "bindings/wasm"
  },
  "homepage": "https://github.com/parsec-html/parsec/wiki/WASM",
  "keywords": ["html", "parser", "html5", "css-selectors", "wasm", "napi"],
  "type": "module",
  "exports": {
    ".": {
      "node": {
        "types": "./index.d.ts",
        "import": "./index.mjs",
        "default": "./index.cjs"
      },
      "types": "./parsec_web.d.ts",
      "default": "./parsec_web.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./index.cjs",
  "types": "./parsec_web.d.ts",
  "files": [
    "index.cjs",
    "index.mjs",
    "index.d.ts",
    "parsec_web.js",
    "parsec_web.d.ts",
    "parsec_web_bg.wasm",
    "parsec_web_bg.wasm.d.ts",
    "node/",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "napi": {
    "binaryName": "parsec-web",
    "packageName": "@parsec-web/binding"
  }
}
