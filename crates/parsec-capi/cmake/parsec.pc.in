prefix=${pcfiledir}/../..
includedir=${prefix}/include
libdir=${prefix}/lib

Name: parsec
Description: An HTML parser that follows the WHATWG HTML Standard, with CSS selectors
URL: https://github.com/parsec-html/parsec
Version: @VERSION@
Cflags: -I${includedir}
Libs: -L${libdir} -lparsec
Libs.private: @PC_PRIVATE@
